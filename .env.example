# Copy to .env and fill in. Only needed for the optional sources below;
# the public OPERA archive (ORD bucket) needs no credentials.

# ArcoDataHub (opera-plus-it-vmi.zarr, HTTP Basic)
ARCODATAHUB_USERNAME=
ARCODATAHUB_ACCESS_KEY=

# Copernicus Climate Data Store (ERA5-Land, CERRA-Land): personal access token
COPERNICUS_CDS_API_KEY=

# MeteoGate ORD API (last 24 h only)
METEOGATE_USERNAME=
METEOGATE_ACCESS_KEY=

# Optional: data and results outside the repo (defaults: ./data and ./results)
# OPERA_DATA_DIR=/path/to/data
# OPERA_RESULTS_DIR=/path/to/results
